# =====================================================================
# VentureRush Tech (https://venturerushtech.com)
# Apache / LiteSpeed Security, Caching & Compression Rules
# =====================================================================

<IfModule mod_headers.c>
  # HSTS (Force HTTPS for 2 years + preload ready)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Prevent MIME-sniffing & Clickjacking
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Strict Referrer & Permissions Privacy Policies
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy (Allows Google Fonts, self scripts/styles/media & HTTPS images)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://venturerushtech.com data: blob:; media-src 'self' https://venturerushtech.com; connect-src 'self' https://sgachecker.venturerushtech.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me https://sgachecker.venturerushtech.com;"

  # Default Cache-Control for HTML documents (fresh + revalidate)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Long-term Cache-Control for immutable static assets
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|ico|mp4|woff2|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # XML & LLM text feeds
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/rss+xml application/xml image/svg+xml
</IfModule>
